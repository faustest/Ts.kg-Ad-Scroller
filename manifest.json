{
  "manifest_version": 3,
  "name": "Ts.kg Ad Scroller",
  "version": "1.0",
  "description": "Removes ads and skips video ad breaks on ts.kg",
  "permissions": ["scripting", "tabs"],
  "host_permissions": [
    "https://*.ts.kg/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["pageScript.js"],
      "matches": ["https://*.ts.kg/*"]
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Ts.kg Ad Scroller",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
